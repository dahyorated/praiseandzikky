# Copy to .env.local for `vercel dev`, and set the same three in the Vercel
# dashboard under Settings, Environment Variables. Never commit real values,
# this repo is public.

# Service account JSON, base64 encoded so the private key newlines survive.
# Firebase console > Project settings > Service accounts > Generate new private
# key, then:  base64 -i serviceAccount.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT=

# No trailing slash.
FIREBASE_DATABASE_URL=https://praizandzikky-default-rtdb.europe-west1.firebasedatabase.app

# Signs the token that /api/match issues and /api/rsvp verifies.
# Generate with:  openssl rand -base64 48
RSVP_TOKEN_SECRET=

# Resend, for the RSVP confirmation email. Without both of these the send is
# skipped and logged, and RSVPs still work.
RESEND_API_KEY=
RESEND_FROM=Praise & Ezekiel <rsvp@send.praizandzikky.info>
